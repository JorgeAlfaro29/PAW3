@model PAW3.Mvc.Models.HomeViewModel

@{
    ViewData["Title"] = "InventoryList";
}

<h1>InventoryList</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(m => m.Inventory.First().InventoryId)
            </th>
            <th>
                @Html.DisplayNameFor(m => m.Inventory.First().UnitPrice)
            </th>
            <th>
                @Html.DisplayNameFor(m => m.Inventory.First().UnitsInStock)
            </th>
            <th>
                @Html.DisplayNameFor(m => m.Inventory.First().LastUpdated)
            </th>
            <th>
                @Html.DisplayNameFor(m => m.Inventory.First().ProductId)
            </th>
            <th>
                @Html.DisplayNameFor(m => m.Inventory.First().DateAdded)
            </th>
            <th>
                @Html.DisplayNameFor(m => m.Inventory.First().ModifiedBy)
            </th>
            <th>
                @Html.DisplayNameFor(m => m.Inventory.First().Products)
            </th>
            
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Inventory) {
        <tr>
            <td>
                    @Html.DisplayFor(modelItem => item.InventoryId)
            </td>
            <td>
                    @Html.DisplayFor(modelItem => item.UnitPrice)
            </td>
            <td>
                    @Html.DisplayFor(modelItem => item.UnitsInStock)
            </td>
            <td>
                    @Html.DisplayFor(modelItem => item.LastUpdated)
            </td>
            <td>
                    @Html.DisplayFor(modelItem => item.ProductId)
            </td>
            <td>
                    @Html.DisplayFor(modelItem => item.DateAdded)
             </td>
            <td>
                    @Html.DisplayFor(modelItem => item.ModifiedBy)
            </td>
            <td>
                    @Html.DisplayFor(modelItem => item.Products)
            </td>
            <td>
                @Html.ActionLink("Edit", "Edit", new { /* id=item.PrimaryKey */ }) |
                @Html.ActionLink("Details", "Details", new { /* id=item.PrimaryKey */ }) |
                @Html.ActionLink("Delete", "Delete", new { /* id=item.PrimaryKey */ })
            </td>
        </tr>
}
    </tbody>
</table>
