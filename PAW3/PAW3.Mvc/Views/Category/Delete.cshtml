@model PAW3.Models.DTOs.CategoryDTO

@{
    ViewData["Title"] = "Delete Category";
}

<h1>Delete Category</h1>
<hr />

<h4>¿Estás seguro que deseas eliminar esta categoría?</h4>

<div>
    <dl class="row mt-3">
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.CategoryId)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.CategoryId)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.CategoryName)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.CategoryName)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Description)
        </dd>
    </dl>

    <form asp-action="DeleteConfirmed" method="post">
        <input type="hidden" name="id" value="@Model.CategoryId" />
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a asp-action="CategoryList" class="btn btn-secondary ms-2">Cancelar</a>
    </form>
</div>
